# ============================================================================
# Notification env vars — placeholders. Real secrets live in .env / .env.local
# (gitignored) locally, and in the Vercel dashboard for production.
# ============================================================================

# --- Database (Supabase Postgres) ---------------------------------------------
# Serverless (Vercel) MUST use the TRANSACTION pooler (port 6543), which pools
# per-transaction. The SESSION pooler (port 5432) holds one server connection per
# client for the whole session and is capped at 15 clients → warm function
# instances exhaust it (EMAXCONNSESSION: "max clients reached in session mode").
#
# Runtime (the app): transaction pooler, port 6543.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations / db push only: a SESSION or DIRECT connection, port 5432 (the
# transaction pooler can't run migrations). prisma.config.ts prefers DIRECT_URL.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# --- Auth / session (REQUIRED in production) ----------------------------------
# SESSION_SECRET signs the ss_auth cookie (HMAC-SHA256). REQUIRED — the app
# refuses to boot in production without it (an unset value would make the key a
# public constant, letting anyone forge a session for any email, incl. an admin).
# Use a long random string, e.g.  openssl rand -base64 48
# Rotating it invalidates every existing session (forces re-login) — do that now,
# since any token minted under the old dev fallback was forgeable.
SESSION_SECRET=
# Comma-separated emails granted ADMIN on sign-in. Keep tight.
ADMIN_EMAILS=
# Clerk (email-OTP delivery only). From the Clerk dashboard.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Web Push (VAPID) ---------------------------------------------------------
# FREE, self-generated. No account. Generate a pair with:
#   npx web-push generate-vapid-keys
# Put the SAME public key in both VAPID_PUBLIC_KEY and NEXT_PUBLIC_VAPID_PUBLIC_KEY.
# NEXT_PUBLIC_* is baked into the client bundle at build time → set it BEFORE the
# build and redeploy after any change. Without these, push is silently off (bell
# still works); the Settings push toggle will read "not supported".
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_SUBJECT=mailto:notifications@yourdomain.com

# --- Email (Resend) — optional, leave blank to keep email off -----------------
# Sign up at resend.com, verify a sending domain, paste the API key. Until set,
# sendNotificationEmail() is a silent no-op (no crash). RESEND_FROM must use a
# verified domain. NEXT_PUBLIC_APP_URL makes email links absolute.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Sip Stories <notifications@yourdomain.com>
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# --- Google Analytics & public-site SEO --------------------------------------
# GA4 Measurement ID. Analytics loads only after explicit visitor consent.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# Current public host. Keep staging noindex until the production domain is live.
NEXT_PUBLIC_APP_URL=https://staging.mysipstories.com
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Scheduled jobs (Vercel Cron) ---------------------------------------------
# Powers the nightly cron jobs (vercel.json): /api/cron/recompute (rebuilds the
# personalization signals — taste vectors + item similarity) and /api/cron/purge
# (DPDP retention). REQUIRED — both endpoints stay disabled (503) without it and
# reject requests lacking the bearer token. Vercel sends
# `Authorization: Bearer <CRON_SECRET>` automatically when this is set.
# CRON_SECRET=a-long-random-string
