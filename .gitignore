# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-dev/
/.xcode-derived/
/out/

# Xcode user state and local build products
**/xcuserdata/
**/*.xcuserstate
**/DerivedData/
**/.derived-device/
**/Artifacts/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local-only backups & reference material (not part of the app)
.backup_pregraphics/
references/
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# clerk configuration (can include secrets)
/.clerk/

# Stitch design reference (local only)
.stitch-ref/

# Local-only auth helper (see scripts/dev-login.ts header) — never ship
scripts/dev-login.ts
dev-login-cookie.txt
START-SIPSTORIES.bat
scripts/db-check.mjs
.env.backup
scripts/clerk-check.mjs

# Design reference + agent scratch — not part of the app, ~10MB of PNGs that
# would be re-uploaded on every Vercel build.
/Sipstories_stitch/
/Claude outputs/
